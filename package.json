{
  "name": "slipstream-npc",
  "version": "0.0.0",
  "private": true,
  "description": "Slipstream-NPC — peaceful NPCs voiced by ElevenLabs, friendship graph, retaliation only when attacked",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "deploy:party": "pnpm --filter party deploy",
    "deploy:client": "pnpm --filter client build && echo 'Push to Git or run: vercel --prod'",
    "extract:collision": "node scripts/extract-map-collision.mjs",
    "extract:nav": "node scripts/extract-map-nav.mjs",
    "catalogue": "node scripts/animation-catalogue.mjs",
    "bake:characters": "node scripts/bake-character-glb.mjs",
    "bake:bible": "node scripts/bake-world-bible.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "sync:kb": "node scripts/upload-knowledge-base.mjs",
    "npc:state": "node scripts/set-npc-state.mjs",
    "session:last": "node scripts/session-last.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
