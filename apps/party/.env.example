# PartyKit server env. Copy to .env (gitignored) for local dev.
# In production, set the same keys on your PartyKit project:
#   npx partykit env add ACCESS_CODE <your-code>
#   npx partykit env add ELEVENLABS_AGENT_TOOL_SECRET <random-hex>
#   npx partykit env add ELEVENLABS_API_KEY <sk_...>

# 4-digit room gate. Players type this in the lobby to join. Set to whatever
# you want for your deploy. Unset = no gate (handy on a private LAN; not
# recommended in production).
ACCESS_CODE=

# Random hex string. The server constant-time compares the `secret` query
# param on every ElevenLabs webhook call against this value. Generate one
# with `openssl rand -hex 24`. Paste the same value into every agent's
# webhook tool definition in the ElevenLabs dashboard.
ELEVENLABS_AGENT_TOOL_SECRET=

# Your ElevenLabs account API key. Used at runtime by the Phase 3+ decoupled
# NPC stack to stream TTS for NPCs flagged `useDecoupledStack: true` in
# packages/shared/src/npc-roster.ts, and by scripts/upload-knowledge-base.mjs
# for the legacy ConvAI knowledge base. Starts with `sk_`.
ELEVENLABS_API_KEY=

# Anthropic API key. Used by the Phase 3+ decoupled NPC stack to stream LLM
# responses (Claude Haiku for the fast path) per NPC turn. The agent's baked
# persona, persona deltas, world bible, scene context, and recent transcript
# are all sent as system messages on each call. No streaming key, no scopes
# — a regular API key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Deepgram project API key. The server mints short-lived access tokens with
# this and hands them to each connected player; the player's browser opens
# a streaming WebSocket to Deepgram with the token and pipes mic audio for
# STT. The project key itself never reaches the browser. Get one at
# https://console.deepgram.com/. Required for Phase 2+ scene transcripts;
# without it, peer-to-peer voice still works but no transcripts reach the
# server.
DEEPGRAM_API_KEY=
